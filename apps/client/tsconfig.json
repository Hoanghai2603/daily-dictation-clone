{
    "extends": "@daily-dictation/typescript-config/nextjs.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@daily-dictation/ui/*": [
                "../../packages/ui/src/*"
            ],
            "@daily-dictation/ui/globals.css": [
                "../../packages/ui/globals.css"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "next-env.d.ts",
        "next.config.js",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}